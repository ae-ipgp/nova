# Copy to .env.local for local development. Never commit real values.
# Everything here is bundled into the browser, so only PUBLIC values belong here.

# Supabase — authentication only (no data is stored in Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Apps Script web app URL (Deploy → Web app → URL ending in /exec)
VITE_API_URL=

VITE_APP_BASE_URL=http://localhost:5173

# Secrets are NOT set here. They are Apps Script Script Properties
# (Project Settings → Script properties), see backend/README.md:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY (Phase 1, invites)
#   SPREADSHEET_DATA_ID, SPREADSHEET_AUDIT_ID, DRIVE_ROOT_FOLDER_ID (written by setupSpreadsheet)
