# Copy to .env.local for local development. Never commit real values.
#
# Browser-visible (VITE_ prefix is bundled into client code — public values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_BASE_URL=http://localhost:5173

# Server-only — set in Supabase Edge Function secrets / Vercel env, NEVER with VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
APP_BASE_URL=
